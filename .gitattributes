# Normalize text files
* text=auto
*.cpp text eol=crlf
*.h text eol=crlf
*.cs text eol=crlf
*.ini text eol=crlf
*.uproject text eol=crlf
*.md text eol=crlf

# Unreal binary assets: never diff or merge
*.uasset binary
*.umap binary
*.fbx binary
*.png binary
*.jpg binary
*.tga binary
*.wav binary
*.ogg binary

# Once Git LFS is installed (see PROJECT_PROGRESS.md), replace the binary lines above with e.g.:
# *.uasset filter=lfs diff=lfs merge=lfs -text
# *.umap   filter=lfs diff=lfs merge=lfs -text
# Unreal binaries and media go through Git LFS (set up 0.19; older history stays as regular objects).
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
